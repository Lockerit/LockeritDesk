{
  "name": "lockerit",
  "private": true,
  "type": "module",
  "version": "1.3.0",
  "description": "Sistema de Asignación de Casilleros",
  "author": {
    "name": "Lockerit - Camilo Diaz",
    "email": "lockerit0625@gmail.com",
    "url": "https://www.tu-sitio-web.com"
  },
  "main": "electron/main/main.js",
  "homepage": ".",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:watch": "concurrently \"vite\" \"wait-on http://localhost:5173 && electronmon .\"",
    "clean": "del-cli dist release",
    "build:web": "vite build",
    "build:electron": "electron-builder",
    "build:linux": "npm run clean && npm run build:web && electron-builder --linux",
    "build:win": "npm run clean && npm run build:web && electron-builder --win",
    "build:all": "npm run clean && npm run build:web && electron-builder -w -l",
    "build": "npm run clean && npm run build:web && npm run build:electron",
    "docker:build": "docker-compose build",
    "docker:linux": "docker-compose run --rm electron-builder npm run build:linux",
    "docker:win": "docker-compose run --rm electron-builder npm run build:win",
    "docker:all": "docker-compose run --rm electron-builder npm run build:all",
    "preview": "vite preview",
    "test:range": "node ./src/features/utils/testGetDateRange.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --fix",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/nunito": "^5.2.6",
    "@mui/icons-material": "^7.2.0",
    "@mui/lab": "^7.0.0-beta.16",
    "@mui/material": "^7.2.0",
    "@mui/styled-engine-sc": "^7.2.0",
    "@mui/x-date-pickers": "^8.10.0",
    "@mui/x-date-pickers-pro": "^8.10.1",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-draggable": "^4.5.0",
    "react-router-dom": "^7.6.3",
    "react-simple-keyboard": "^3.8.120",
    "say": "^0.16.0",
    "simple-keyboard": "^3.8.82",
    "simple-keyboard-layouts": "^3.4.128",
    "source-map-support": "^0.5.21",
    "styled-components": "^6.1.19",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "del-cli": "^7.0.0",
    "electron": "^37.2.2",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.lockerit.desk",
    "productName": "Lockerit",
    "copyright": "© 2025 Lockerit. All rights reserved.",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**",
      "src/assets/**",
      "configFiles/**",
      "package.json"
    ],
    "extraResources": [
      "configFiles/.env",
      "configFiles/setup_config.json",
      "configFiles/lockers_colors_config.json",
      "configFiles/auth_key.json",
      "configFiles/logger_config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "./src/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "./src/assets/icons"
    }
  }
}